# ============================================
# Listing Quality Sync — Variables de entorno
# ============================================
# Copia este archivo a .env.local y llena los valores.
# NUNCA subas .env.local a git.

# --- Anthropic (IA para scoring) ---
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- EasyBroker API (fuente primaria de datos) ---
# Staging: key pública documentada en https://dev.easybroker.com/docs
# La key de staging es pública y se usa para desarrollo/demo.
# Para producción necesitarás una key privada de tu cuenta EasyBroker.
EASYBROKER_API_KEY=l7u502p8v46ba3ppgvj5y2aad50lb9
EASYBROKER_BASE_URL=https://api.stagingeb.com

# --- Google Sheets (fuente secundaria / fallback) ---
# Solo necesario si usas mode "sheets" en config.
# 1. Crear un Service Account en Google Cloud Console
# 2. Descargar el JSON de credenciales
# 3. Copiar el campo "client_email" aquí:
GOOGLE_SERVICE_ACCOUNT_EMAIL=mi-service-account@proyecto.iam.gserviceaccount.com

# 4. Copiar el campo "private_key" del JSON aquí (preservar los \n):
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
